# Plantilla de variables de entorno. Copie a .env.local (local) o cárguelas en el hosting.
# Los valores reales (contraseñas, webhook) nunca van a Git.

# ── Correo (SMTP de MegaLink) ─────────────────────────────────────────────
# Verificar con: pnpm mail:check (sin enviar) o pnpm mail:check --enviar
SMTP_HOST=mail.metrica.com.bo
# 465 = TLS directo (SMTP_SECURE=true) · 587 = STARTTLS (SMTP_SECURE=false)
SMTP_PORT=465
SMTP_SECURE=true
# mail.metrica.com.bo presenta el certificado *.megalink.com de h22.megalink.com: se valida con ese nombre
SMTP_TLS_SERVERNAME=h22.megalink.com
SMTP_USER=comercial@metrica.com.bo
SMTP_PASSWORD=
MAIL_FROM="Sitio web Métrica <comercial@metrica.com.bo>"

# Buzón de cada formulario (varios separados por coma). Los vacíos usan MAIL_TO_DEFAULT.
MAIL_TO_DEFAULT=comercial@metrica.com.bo,asistencia@metrica.com.bo
# Contacto y cotizaciones
MAIL_TO_COMERCIAL=
# Solicitudes de calibración
MAIL_TO_LABORATORIO=
# Solicitudes de soporte técnico
MAIL_TO_SOPORTE=
# Postulaciones (Trabaja con nosotros)
MAIL_TO_RRHH=
# Reclamos y sugerencias
MAIL_TO_CALIDAD=

# ── Bitrix24 (cotización, calibración y soporte → CRM › Prospectos) ────────
# Webhook entrante con permiso crm. Es una credencial: solo en .env.local y en el hosting.
BITRIX24_WEBHOOK_URL=
# Valores del Bitrix24 de METRICA (crm.status.list / crm.lead.fields, 13/10/2026):
# etapa "Sin asignar", fuente "Pagina Web", "Ciudad del prospecto" (obligatorio), "Tipo de oportunidad"
# y "Archivo adjunto" (formulario de calibración, fotos del equipo)
BITRIX24_LEAD_STATUS_ID=NEW
BITRIX24_LEAD_SOURCE_ID=UC_QXO496
BITRIX24_FIELD_CITY=UF_CRM_LEAD_1790626227373
BITRIX24_FIELD_OPPORTUNITY_TYPE=UF_CRM_1790601080
BITRIX24_FIELD_ATTACHMENTS=UF_CRM_6AB28B8203F3E
# Responsable de los prospectos (ID de usuario); vacío = el usuario del webhook
BITRIX24_LEAD_ASSIGNED_BY_ID=
# Formato del comentario del prospecto: text, bbcode o html
BITRIX24_COMMENTS_FORMAT=bbcode

# ── Asesor virtual (IA) ───────────────────────────────────────────────────
# Clave de Google AI Studio (aistudio.google.com) de una cuenta de la empresa. Es una credencial.
# Sin clave, el chat avisa que no está disponible y ofrece WhatsApp.
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelo de Gemini (por defecto gemini-3.5-flash-lite: rápido, económico y con capa gratuita)
ASSISTANT_MODEL=
# Consultas por día de todo el sitio, para no agotar la cuota de la IA (por defecto 400)
ASSISTANT_DAILY_LIMIT=

# ── Catálogo y panel (/panel) ─────────────────────────────────────────────
# Base MariaDB/MySQL del catálogo y los usuarios del panel. Es una credencial.
# En Plesk: Bases de datos → la base y su usuario; el host suele ser localhost.
DATABASE_URL=mysql://usuario:contraseña@localhost:3306/base
# Carpeta de las imágenes y fichas que sube el panel: FUERA de la carpeta de la aplicación, para que
# los despliegues no la borren (ruta absoluta). En desarrollo, por defecto ./storage
UPLOADS_DIR=
# Firma de las sesiones del panel: una cadena larga y aleatoria, distinta en cada entorno. Credencial.
BETTER_AUTH_SECRET=
# Dirección pública del sitio (https://www.metrica.com.bo); en desarrollo, http://localhost:3001
BETTER_AUTH_URL=
# Código para crear la cuenta del primer administrador en /panel/configuracion (solo se usa una vez)
PANEL_SETUP_TOKEN=
